@prefix pbs: <https://schema.pragmaticbim.ch/> .
@prefix rule: <https://schema.pragmaticbim.ch/demo/rules/sia358/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix view: <https://schema.pragmaticbim.ch/demo/view/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SIA 358 (Geländer und Brüstungen): height of fall protection.
#
#   - Guard height at least 1.00 m above the walking surface.
#   - At least 1.10 m where the drop height exceeds 12 m.
#
# Evidence computed by ifc2rdf from geometry (contract/mapping/_computed_relations.yaml):
#   SafetyBarrier pbs:guards_space Space, and the QuantityValue
#   quantity_type_height_above_walking_surface = barrier top - highest guarded floor.
# The drop height is estimated from the storey elevation of the guarded space above ±0.00
# (conservative at façades; galleries inside the building fall less).
# Not covered: openings (12 cm sphere), climbability, stair railings measured at the nosing.

rule:prefixes
    sh:declare [ sh:prefix "pbs" ; sh:namespace "https://schema.pragmaticbim.ch/"^^xsd:anyURI ] .

rule:GuardHeight a sh:NodeShape ;
    view:relation pbs:guards_space ;
    sh:name "SIA 358: guard height above the walking surface" , "SIA 358: Höhe der Absturzsicherung über der Gehfläche"@de ;
    sh:description "Fall protection is at least 1.00 m above the walking surface it guards, and at least 1.10 m where the drop height exceeds 12 m." ,
        "Die Absturzsicherung ist mindestens 1.00 m über der gesicherten Gehfläche, bei einer Absturzhöhe über 12 m mindestens 1.10 m."@de ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf pbs:guards_space ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes rule:prefixes ;
        sh:message "Guard {?height} m above the walking surface; SIA 358 requires at least {?required} m (estimated drop height {?drop} m)." ,
            "Absturzsicherung {?height} m über der Gehfläche; SIA 358 verlangt mindestens {?required} m (geschätzte Absturzhöhe {?drop} m)."@de ;
        sh:select """
            SELECT DISTINCT $this ?height ?required ?drop WHERE {
                $this pbs:quantity_values ?q ; pbs:guards_space ?space .
                ?q pbs:quantity_type pbs:quantity_type_height_above_walking_surface ;
                   pbs:quantity_value ?height .
                OPTIONAL { ?space pbs:parent_level ?level . ?level pbs:elevation ?elevation }
                BIND (COALESCE(?elevation, 0.0) AS ?drop)
                BIND (IF(?drop > 12.0, 1.10, 1.00) AS ?required)
                FILTER (?height < ?required)
            }"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes rule:prefixes ;
        sh:message "Guard height above the walking surface could not be determined (no geometry)." ,
            "Höhe der Absturzsicherung über der Gehfläche nicht bestimmbar (keine Geometrie)."@de ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this pbs:quantity_values ?q .
                    ?q pbs:quantity_type pbs:quantity_type_height_above_walking_surface .
                }
            }"""
    ] .
