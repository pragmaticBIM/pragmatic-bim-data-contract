@prefix pbs: <https://schema.pragmaticbim.ch/> .
@prefix rule: <https://schema.pragmaticbim.ch/demo/rules/fire/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Fire safety: doors in fire-resistant walls.
#
# A door hosted by a fire-resistant wall needs a fire resistance at most one class below
# the wall. Classes in ascending order:
#
#   E30 < EI30 < EI60 < EI90 < EI120 < EI180 < EI240
#
#   wall EI30 -> door E30, wall EI60 -> door EI30, wall EI90 -> door EI60, ...
#
# Ratings are the normalized fire_property_resistance_rating values (EN 13501-2 classes,
# whitespace removed: "EI 60-C" -> EI60). REI counts as EI and DIN F/T classes count as EI
# with the same minutes. E-only classes (E30, E60) rank one step below EI of the same minutes.
# Evidence: door pbs:hosted_by wall (IFC openings, or geometry when IFC does not state it).

rule:prefixes
    sh:declare
        [ sh:prefix "pbs" ; sh:namespace "https://schema.pragmaticbim.ch/"^^xsd:anyURI ] ,
        [ sh:prefix "ifc" ; sh:namespace "https://w3id.org/ifc/IFC4_ADD2#"^^xsd:anyURI ] ,
        [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .

rule:DoorFireRating a sh:NodeShape ;
    sh:name "Doors in fire-resistant walls: at most one class below the wall" , "Türen in Brandschutzwänden: höchstens eine Klasse unter der Wand"@de ;
    sh:description "A door in a fire-resistant wall has a fire resistance at most one class below the wall (E30 < EI30 < EI60 < EI90 < EI120 ...)." ,
        "Eine Tür in einer Wand mit Feuerwiderstand liegt höchstens eine Klasse unter der Wand (E30 < EI30 < EI60 < EI90 < EI120 ...)."@de ;
    sh:severity sh:Violation ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes rule:prefixes ;
        sh:select """
            SELECT DISTINCT ?this WHERE {
                ?this a pbs:ConnectionPhysical ;
                      pbs:connection_physical_type ifc:IfcDoor ;
                      pbs:hosted_by ?wall .
                ?wall pbs:performance_properties ?f .
                ?f pbs:property_key pbs:fire_property_resistance_rating ;
                   pbs:property_value_string ?rating .
                FILTER (REGEX(?rating, "^(R?EI|F)[0-9]+$"))
            }"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes rule:prefixes ;
        sh:message "Door rated {?doorRating} in a {?wallRating} wall; required at least {?requiredRating}." ,
            "Tür ({?doorRatingDe}) in einer {?wallRating}-Wand; erforderlich mindestens {?requiredRating}."@de ;
        sh:select """
            SELECT DISTINCT $this ?doorRating ?doorRatingDe ?wallRating ?requiredRating WHERE {
                $this pbs:hosted_by ?wall .
                ?wall pbs:performance_properties ?wf .
                ?wf pbs:property_key pbs:fire_property_resistance_rating ;
                    pbs:property_value_string ?wallRating .
                FILTER (REGEX(?wallRating, "^(R?EI|F)[0-9]+$"))
                OPTIONAL {
                    $this pbs:performance_properties ?df .
                    ?df pbs:property_key pbs:fire_property_resistance_rating ;
                        pbs:property_value_string ?dr .
                }
                BIND (COALESCE(?dr, "none") AS ?doorRating)
                BIND (COALESCE(?dr, "ohne Feuerwiderstand") AS ?doorRatingDe)

                # Step of the minutes on the ladder 30, 60, 90, 120, 180, 240 (1..6).
                BIND (xsd:integer(REPLACE(?wallRating, "^[A-Z]+", "")) AS ?wallMinutes)
                BIND (IF(?wallMinutes >= 240, 6, IF(?wallMinutes >= 180, 5, IF(?wallMinutes >= 120, 4,
                      IF(?wallMinutes >= 90, 3, IF(?wallMinutes >= 60, 2, IF(?wallMinutes >= 30, 1, 0)))))) AS ?wallStep)
                BIND (IF(BOUND(?dr), xsd:integer(REPLACE(?dr, "^[A-Z]+", "")), 0) AS ?doorMinutes)
                BIND (IF(?doorMinutes >= 240, 6, IF(?doorMinutes >= 180, 5, IF(?doorMinutes >= 120, 4,
                      IF(?doorMinutes >= 90, 3, IF(?doorMinutes >= 60, 2, IF(?doorMinutes >= 30, 1, 0)))))) AS ?doorStep)

                # Position on E30 < EI30 < EI60 < ...: EI classes at 2 * step, E-only one below.
                BIND (2 * ?wallStep AS ?wallRank)
                BIND (IF(?doorStep = 0, 0, IF(REGEX(?doorRating, "^E[0-9]"), 2 * ?doorStep - 1, 2 * ?doorStep)) AS ?doorRank)
                BIND (IF(?wallStep = 1, 1, 2 * (?wallStep - 1)) AS ?requiredRank)
                FILTER (?doorRank < ?requiredRank)

                BIND (IF(?wallStep = 1, "E30", IF(?wallStep = 2, "EI30", IF(?wallStep = 3, "EI60",
                      IF(?wallStep = 4, "EI90", IF(?wallStep = 5, "EI120", "EI180"))))) AS ?requiredRating)
            }"""
    ] .
