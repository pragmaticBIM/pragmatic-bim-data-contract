  skos:notation "USE-WH" ;
  skos:prefLabel "Housing"@en ;
  skos:prefLabel "Wohnen"@de ;
  skos:prefLabel "Habitation"@fr ;
  skos:prefLabel "Abitazione"@it ;
  skos:definition "Permanent residence of households."@en ;
  skos:definition "Dauerhaftes Wohnen von Haushalten."@de ;
  skos:definition "Logement permanent de ménages."@fr ;
  skos:definition "Abitazione permanente di nuclei domestici."@it .

