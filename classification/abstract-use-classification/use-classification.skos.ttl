:passenger-transport a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "USE-VE" ;
  skos:prefLabel "Passenger transport"@en ;
  skos:prefLabel "Personenverkehr"@de ;
  skos:prefLabel "Transport de voyageurs"@fr ;
  skos:prefLabel "Trasporto passeggeri"@it ;
  skos:definition "Handling and waiting of travellers, for example in station halls, terminals and waiting areas."@en ;
  skos:definition "Abfertigung und Aufenthalt von Reisenden, etwa in Bahnhofshallen, Terminals und Wartebereichen."@de ;
  skos:definition "Prise en charge et séjour de voyageurs, p. ex. dans les halls de gare, terminaux et zones d'attente."@fr ;
  skos:definition "Accoglienza e permanenza di viaggiatori, ad es. in atri di stazione, terminal e zone d'attesa."@it ;
  skos:scopeNote "Car parks and garages belong to Parking. Retail, food service and offices in the same building get their own use."@en ;
  skos:scopeNote "Parkhäuser und Einstellhallen gehören zu Parkierung. Verkauf, Gastronomie und Büros im selben Gebäude erhalten ihre eigene Nutzung."@de ;
  skos:scopeNote "Les parkings et garages relèvent du Stationnement. Vente, restauration et bureaux dans le même bâtiment reçoivent leur propre usage."@fr ;
  skos:scopeNote "Autosilo e autorimesse rientrano nel Parcheggio. Vendita, ristorazione e uffici nello stesso edificio ricevono il proprio uso."@it .

:storage a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "USE-KL" ;
  skos:prefLabel "Cellar and storage"@en ;
  skos:prefLabel "Keller und Lager"@de ;
  skos:prefLabel "Caves et dépôts"@fr ;
  skos:prefLabel "Cantine e depositi"@it ;
  skos:definition "Storage rooms for the occupants."@en ;
  skos:definition "Abstell- und Lagerräume für die Nutzerinnen und Nutzer."@de ;
  skos:definition "Locaux de rangement et de stockage pour les usagers."@fr ;
  skos:definition "Locali di deposito e ripostiglio per gli utenti."@it .

:parking a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "USE-PK" ;
  skos:prefLabel "Parking"@en ;
  skos:prefLabel "Parkierung"@de ;
  skos:prefLabel "Stationnement"@fr ;
  skos:prefLabel "Parcheggio"@it ;
  skos:definition "Parking of vehicles in garages and on parking spaces."@en ;
  skos:definition "Abstellen von Fahrzeugen in Einstellhallen und auf Parkplätzen."@de ;
  skos:definition "Stationnement de véhicules dans des garages et sur des places de parc."@fr ;
  skos:definition "Parcheggio di veicoli in autorimesse e su posteggi."@it ;
  skos:scopeNote "Also applies to standalone car parks."@en ;
  skos:scopeNote "Gilt auch für eigenständige Parkhäuser."@de ;
  skos:scopeNote "S'applique aussi aux parkings indépendants."@fr ;
  skos:scopeNote "Vale anche per autosilo indipendenti."@it .

