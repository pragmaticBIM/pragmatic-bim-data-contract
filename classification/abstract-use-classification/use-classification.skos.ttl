@prefix : <https://example.org/ch/abstract-use/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

:scheme a skos:ConceptScheme ;
  skos:prefLabel "Abstract use classification"@en ;
  skos:prefLabel "Abstrakte Nutzungsklassifikation"@de ;
  skos:prefLabel "Classification abstraite des usages"@fr ;
  skos:prefLabel "Classificazione astratta degli usi"@it ;
  dcterms:title "Abstract use classification"@en ;
  dcterms:identifier "AbstractUseClassification" ;
  dcterms:creator "pragmatic-bim-public-rules" ;
  dcterms:issued "2026-10-04" ;
  dcterms:description "Uses of a building or part of a building. Each gross volume carries exactly one use; uses do not overlap. Links to space activity, SIA 416 and SIA 380/1 are in the use mappings."@en ;
  dcterms:description "Nutzungen eines Gebäudes oder Gebäudeteils. Jedes Bruttovolumen trägt genau eine Nutzung; Nutzungen überschneiden sich nicht. Die Zuordnungen zu Raumaktivität, SIA 416 und SIA 380/1 stehen in den Nutzungs-Mappings."@de ;
  dcterms:description "Usages d'un bâtiment ou d'une partie de bâtiment. Chaque volume brut porte exactement un usage ; les usages ne se recoupent pas. Les correspondances avec l'activité des locaux, la SIA 416 et la SIA 380/1 figurent dans les mappings d'usage."@fr ;
  dcterms:description "Usi di un edificio o di una sua parte. Ogni volume lordo porta esattamente un uso; gli usi non si sovrappongono. Le corrispondenze con l'attività dei locali, la SIA 416 e la SIA 380/1 sono nei mapping degli usi."@it ;
  skos:hasTopConcept
    :residential, :office, :education, :retail, :food-service, :accommodation, :assembly, :healthcare, :production, :logistics, :sport, :laboratory, :data-centre, :passenger-transport, :storage, :parking, :building-services .

:residential a skos:Concept ;
