@prefix rcp: <https://example.org/abstract/roof-covering-product/> .
@prefix din276: <https://example.org/de/din276/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix map: <https://example.org/mapping/> .

map:abstractRoofCoveringProductsToDin276Mapping a dcterms:Dataset ;
  dcterms:title "Abstract roof covering products to DIN 276 mapping"@en ;
  dcterms:title "Mapping abstrakter Dachbekleidungsprodukte nach DIN 276"@de ;
  dcterms:references rcp:scheme, din276:scheme ;
  dcterms:issued "2026-11-27" ;
  dcterms:description "Maps abstract roof covering product concepts to DIN 276:2018 Kostengruppen by reference only: roof coverings 363, structure-heavy related 361, roof openings related 362, photovoltaics 442. Codes are referenced by notation; DIN 276 is published by DIN and no DIN titles or definitions are reproduced. Licence holders resolve the codes against their own copy. closeMatch is the leading cost group; relatedMatch marks a secondary or adjacent group. Disambiguation: DIN 276 is deliberately not bijective."@en ;
  dcterms:description "Ordnet abstrakte Dachbekleidungsprodukte den Kostengruppen der DIN 276:2018 nur per Referenz zu: Dachbelaege 363, konstruktionsnahe related 361, Dachoeffnungen related 362, Photovoltaik 442. Codes nur ueber Notation; DIN 276 wird vom DIN herausgegeben, es werden keine DIN-Bezeichnungen oder -Definitionen wiedergegeben. Lizenznehmende loesen die Codes mit ihrer eigenen Ausgabe auf. closeMatch ist die Leitgruppe; relatedMatch eine sekundaere oder benachbarte Gruppe. Disambiguierung: DIN 276 ist bewusst nicht eindeutig."@de .

# --- Flat roofs: sealing membranes ---

rcp:RCP-FLAT-BITUMEN skos:closeMatch din276:363 .

rcp:RCP-FLAT-SINGLE-PLY skos:closeMatch din276:363 .

rcp:RCP-FLAT-LIQUID skos:closeMatch din276:363 .

# --- Pitched roofs: coverings ---

rcp:RCP-TILE-CLAY skos:closeMatch din276:363 .

rcp:RCP-TILE-CONCRETE skos:closeMatch din276:363 .

rcp:RCP-SLATE skos:closeMatch din276:363 .

rcp:RCP-WOOD-SHINGLE skos:closeMatch din276:363 ;
  skos:relatedMatch din276:361 .

rcp:RCP-METAL-SHEET skos:closeMatch din276:363 .

# --- Green roofs and roof-mounted systems ---

rcp:RCP-GREEN-EXTENSIVE skos:closeMatch din276:363 .

rcp:RCP-GREEN-INTENSIVE skos:closeMatch din276:363 .

rcp:RCP-PV-ROOF skos:closeMatch din276:442 ;
  skos:relatedMatch din276:363 .

rcp:RCP-PV-MOUNTED skos:closeMatch din276:442 ;
  skos:relatedMatch din276:363 .

rcp:RCP-PV-INTEGRATED skos:closeMatch din276:442, din276:363 .
