@prefix fdp: <https://example.org/abstract/foundation-product/> .
@prefix din276: <https://example.org/de/din276/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix map: <https://example.org/mapping/> .

map:abstractFoundationProductsToDin276Mapping a dcterms:Dataset ;
  dcterms:title "Abstract foundation products to DIN 276 mapping"@en ;
  dcterms:title "Mapping abstrakter Fundamentprodukte nach DIN 276"@de ;
  dcterms:references fdp:scheme, din276:scheme ;
  dcterms:issued "2026-11-27" ;
  dcterms:description "Maps abstract foundation product concepts to DIN 276:2018 Kostengruppen by reference only: shallow foundations 322, deep foundations 323, ground improvement 321, waterproofing 325, drainage 326, excavation support related 312. Codes are referenced by notation; DIN 276 is published by DIN and no DIN titles or definitions are reproduced. Licence holders resolve the codes against their own copy. closeMatch is the leading cost group; relatedMatch marks a secondary or adjacent group. Disambiguation: DIN 276 is deliberately not bijective."@en ;
  dcterms:description "Ordnet abstrakte Fundamentprodukte den Kostengruppen der DIN 276:2018 nur per Referenz zu: Flachgruendungen 322, Tiefgruendungen 323, Baugrundverbesserung 321, Abdichtungen 325, Draenagen 326, Baugrubenverbau related 312. Codes nur ueber Notation; DIN 276 wird vom DIN herausgegeben, es werden keine DIN-Bezeichnungen oder -Definitionen wiedergegeben. Lizenznehmende loesen die Codes mit ihrer eigenen Ausgabe auf. closeMatch ist die Leitgruppe; relatedMatch eine sekundaere oder benachbarte Gruppe. Disambiguierung: DIN 276 ist bewusst nicht eindeutig."@de .

# --- Cast concrete foundations ---

fdp:FDP-RAFT skos:closeMatch din276:322 .

fdp:FDP-STRIP skos:closeMatch din276:322 .

fdp:FDP-PAD skos:closeMatch din276:322 .

fdp:FDP-RETAINING skos:closeMatch din276:322, din276:312 .

fdp:FDP-RETAINING-INSITU skos:closeMatch din276:322, din276:312 .

fdp:FDP-RETAINING-PRECAST skos:closeMatch din276:322, din276:312 .

fdp:FDP-RETAINING-SHORING skos:closeMatch din276:312 ;
  skos:relatedMatch din276:322 .

# --- Deep foundations and ground improvement ---

fdp:FDP-PILE skos:closeMatch din276:323 .

fdp:FDP-PILE-DRIVEN skos:closeMatch din276:323 .

fdp:FDP-PILE-BORED skos:closeMatch din276:323 .

fdp:FDP-MICRO-PILE skos:closeMatch din276:323 ;
  skos:relatedMatch din276:321 .

fdp:FDP-MICRO-PILE-GROUTED skos:closeMatch din276:323 ;
  skos:relatedMatch din276:321 .

fdp:FDP-GROUND-INJECTION skos:closeMatch din276:321 .

fdp:FDP-SOIL-REPLACEMENT skos:closeMatch din276:321 .

# --- Sealing, drainage and insulation layers ---

fdp:FDP-WATERPROOF skos:closeMatch din276:325 .

fdp:FDP-WATERPROOF-MEMBRANE skos:closeMatch din276:325 .

fdp:FDP-WATERPROOF-CONCRETE skos:closeMatch din276:325 ;
  skos:relatedMatch din276:322 .

fdp:FDP-DRAINAGE skos:closeMatch din276:326 ;
  skos:relatedMatch din276:325 .

fdp:FDP-RAFT-INS skos:closeMatch din276:325 ;
  skos:relatedMatch din276:322 .

fdp:FDP-RETAINING-INS skos:closeMatch din276:325 ;
  skos:relatedMatch din276:312 .
