@prefix use: <https://example.org/ch/abstract-use/> .
@prefix sia380: <https://example.org/sia/380-1/gebaeudekategorie/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix map: <https://example.org/mapping/> .

map:abstractUseToSia3801Mapping a dcterms:Dataset ;
  dcterms:title "Abstract use to SIA 380/1 building category mapping"@en ;
  dcterms:title "Mapping abstrakter Nutzungen zu SIA-380/1-Gebäudekategorien"@de ;
  dcterms:references use:scheme ;
  dcterms:issued "2026-10-04" ;
  dcterms:description "Maps each use to the SIA 380/1 building categories I to XII used for the energy demand calculation. Housing maps to both I (multi-family) and II (single-family); sport maps to XI (sports buildings) and XII (indoor pools). Accommodation, laboratory and research, data centre, passenger transport and the support uses have no entry; the project assigns their category."@en ;
  dcterms:description "Ordnet jede Nutzung den SIA-380/1-Gebäudekategorien I bis XII für die Berechnung des Heizwärmebedarfs zu. Wohnen ergibt I (MFH) und II (EFH); Sport ergibt XI (Sportbauten) und XII (Hallenbäder). Beherbergung, Labor und Forschung, Rechenzentrum, Personenverkehr und die unterstützenden Nutzungen haben keinen Eintrag; das Projekt legt ihre Kategorie fest."@de .

use:residential skos:closeMatch sia380:I, sia380:II .
use:office skos:closeMatch sia380:III .
use:education skos:closeMatch sia380:IV .
use:retail skos:closeMatch sia380:V .
use:food-service skos:closeMatch sia380:VI .
use:assembly skos:closeMatch sia380:VII .
use:healthcare skos:closeMatch sia380:VIII .
use:production skos:closeMatch sia380:IX .
use:logistics skos:closeMatch sia380:X .
use:sport skos:closeMatch sia380:XI, sia380:XII .
