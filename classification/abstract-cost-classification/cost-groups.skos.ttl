  skos:notation "CG-2-01" ;
  skos:prefLabel "Demolition, site preparation and formation"@en ;
  skos:prefLabel "Rückbau, Baustellenvorbereitung und Geländeformung"@de ;
  skos:definition "Investigation, clearance, demolition, remediation and forming of the site before the permanent works."@en ;
  skos:definition "Untersuchung, Räumung, Rückbau, Sanierung und Formung des Geländes vor den dauerhaften Arbeiten."@de ;
  skos:narrower :CG-2-01-B010, :CG-2-01-B020, :CG-2-01-B030, :CG-2-01-B040, :CG-2-01-B050, :CG-2-01-B060, :CG-2-01-B070, :CG-2-01-B080, :CG-2-01-B090, :CG-2-01-B100, :CG-2-01-B110, :CG-2-01-C010, :CG-2-01-C020, :CG-2-01-C030, :CG-2-01-C040, :CG-2-01-C050, :CG-2-01-C060, :CG-2-01-C070, :CG-2-01-C080, :CG-2-01-C090, :CG-2-01-C100, :CG-2-01-C110, :CG-2-01-C120, :CG-2-01-C650 .

