  skos:prefLabel "External and ancillary works"@en ;
  skos:prefLabel "Umgebungs- und Nebenarbeiten"@de ;
  skos:definition "Retaining structures, enclosures, paving, landscaping and services within the site but outside the main structure."@en ;
  skos:definition "Stützbauwerke, Einfriedungen, Beläge, Begrünung und Werkleitungen auf dem Grundstück ausserhalb des Hauptbauwerks."@de ;
  skos:narrower :CG-2-07-B010, :CG-2-07-B020, :CG-2-07-B030, :CG-2-07-B040, :CG-2-07-B050, :CG-2-07-B060, :CG-2-07-B070, :CG-2-07-C010, :CG-2-07-C020, :CG-2-07-C030, :CG-2-07-C040, :CG-2-07-C050, :CG-2-07-C800 .

:CG-2-08 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:broader :CG-2 ;
  skos:notation "CG-2-08" ;
  skos:prefLabel "Preliminaries and site overheads"@en ;
  skos:prefLabel "Baustellengemeinkosten"@de ;
  skos:definition "Constructor's site management, temporary facilities, shared plant and general obligations not allocated to elements."@en ;
  skos:definition "Baustellenführung, provisorische Einrichtungen, gemeinsame Geräte und allgemeine Pflichten des Unternehmers, die keinem Element zugeordnet sind."@de ;
  skos:narrower :CG-2-08-010, :CG-2-08-020, :CG-2-08-030, :CG-2-08-040, :CG-2-08-050, :CG-2-08-060, :CG-2-08-070, :CG-2-08-080, :CG-2-08-090, :CG-2-08-100, :CG-2-08-110, :CG-2-08-120, :CG-2-08-130, :CG-2-08-140, :CG-2-08-C025, :CG-2-08-C045, :CG-2-08-C055, :CG-2-08-C065 .

:CG-2-09 a skos:Concept ;
