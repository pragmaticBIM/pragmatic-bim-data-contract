  skos:narrower :CG-2-04-B010, :CG-2-04-B020, :CG-2-04-B030, :CG-2-04-B040, :CG-2-04-B050, :CG-2-04-B060, :CG-2-04-B070, :CG-2-04-B080, :CG-2-04-C010, :CG-2-04-C020, :CG-2-04-C030, :CG-2-04-C040, :CG-2-04-C050, :CG-2-04-C060, :CG-2-04-C070, :CG-2-04-C080, :CG-2-04-C090, :CG-2-04-C100 .

