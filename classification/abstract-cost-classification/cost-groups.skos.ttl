  skos:broader :CG-2 ;
  skos:notation "CG-2-11" ;
  skos:prefLabel "Off-site works and utilities"@en ;
  skos:prefLabel "Arbeiten und Werkleitungen ausserhalb des Grundstücks"@de ;
