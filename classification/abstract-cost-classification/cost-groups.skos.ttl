  skos:narrower :CG-2-02-B010, :CG-2-02-B020, :CG-2-02-B030, :CG-2-02-C010, :CG-2-02-C020, :CG-2-02-C025, :CG-2-02-C030, :CG-2-02-C040, :CG-2-02-C050, :CG-2-02-C060, :CG-2-02-C070, :CG-2-02-C080, :CG-2-02-C090, :CG-2-02-C100, :CG-2-02-C110, :CG-2-02-C120, :CG-2-02-C660, :CG-2-02-C680 .

