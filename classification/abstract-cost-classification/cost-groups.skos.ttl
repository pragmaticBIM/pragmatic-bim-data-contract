  skos:narrower :CG-2-05-B010, :CG-2-05-B020, :CG-2-05-B030, :CG-2-05-B040, :CG-2-05-B050, :CG-2-05-B060, :CG-2-05-B070, :CG-2-05-B080, :CG-2-05-B090, :CG-2-05-B100, :CG-2-05-B110, :CG-2-05-B120, :CG-2-05-B130, :CG-2-05-B140, :CG-2-05-B150, :CG-2-05-B160, :CG-2-05-B170, :CG-2-05-B175, :CG-2-05-B180, :CG-2-05-B190, :CG-2-05-B200, :CG-2-05-B210, :CG-2-05-B220, :CG-2-05-B230, :CG-2-05-B240, :CG-2-05-B250, :CG-2-05-B260, :CG-2-05-C005, :CG-2-05-C010, :CG-2-05-C020, :CG-2-05-C030, :CG-2-05-C040, :CG-2-05-C050, :CG-2-05-C060, :CG-2-05-C070, :CG-2-05-C080, :CG-2-05-C090, :CG-2-05-C100, :CG-2-05-C110, :CG-2-05-C115, :CG-2-05-C120, :CG-2-05-C800, :CG-2-05-C810 .

