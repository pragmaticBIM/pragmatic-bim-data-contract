  skos:inScheme :scheme ;
  skos:broader :CG-2 ;
  skos:notation "CG-2-06" ;
  skos:prefLabel "Surface and underground drainage"@en ;
  skos:prefLabel "Oberflächen- und Untergrundentwässerung"@de ;
  skos:definition "Drainage of surface, storm and foul water outside the structure, including connections."@en ;
  skos:definition "Ableitung von Oberflächen-, Regen- und Schmutzwasser ausserhalb des Bauwerks, einschliesslich Anschlüssen."@de ;
  skos:narrower :CG-2-06-B010, :CG-2-06-B020, :CG-2-06-B030, :CG-2-06-B040, :CG-2-06-B050, :CG-2-06-B060, :CG-2-06-C010, :CG-2-06-C020, :CG-2-06-C030, :CG-2-06-C040, :CG-2-06-C050 .

