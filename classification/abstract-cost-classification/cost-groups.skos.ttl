  skos:prefLabel "Risk allowances"@en ;
  skos:prefLabel "Reserven und Teuerung"@de ;
  skos:definition "Allowances for design development, contingencies, price level and exchange rate changes."@en ;
  skos:definition "Reserven für Projektentwicklung, Unvorhergesehenes, Teuerung und Wechselkursänderungen."@de ;
  skos:narrower :CG-2-09-010, :CG-2-09-020, :CG-2-09-030, :CG-2-09-040 .

