  skos:broader :CG-2 ;
  skos:notation "CG-2-12" ;
  skos:prefLabel "Production equipment, furniture and loose fittings"@en ;
  skos:prefLabel "Betriebseinrichtungen, Mobiliar und Ausstattung"@de ;
