  skos:definition "Tragende Konstruktion oberhalb des Unterbaus."@de ;
  skos:narrower :CG-2-03-B010, :CG-2-03-B020, :CG-2-03-B030, :CG-2-03-B040, :CG-2-03-B050, :CG-2-03-C010, :CG-2-03-C020, :CG-2-03-C030, :CG-2-03-C040, :CG-2-03-C050, :CG-2-03-C060, :CG-2-03-C070, :CG-2-03-C080, :CG-2-03-C090, :CG-2-03-C100, :CG-2-03-C105, :CG-2-03-C110, :CG-2-03-C120, :CG-2-03-C130, :CG-2-03-C140, :CG-2-03-C700, :CG-2-03-C720, :CG-2-03-C750 .

