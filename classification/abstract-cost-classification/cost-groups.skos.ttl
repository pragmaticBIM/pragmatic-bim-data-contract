@prefix : <https://example.org/abstract/cost-group/> .
@prefix cpt: <https://example.org/abstract/cost-project-type/> .
@prefix pbs: <https://schema.pragmaticbim.ch/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix map: <https://example.org/mapping/> .

:scheme a skos:ConceptScheme ;
  skos:prefLabel "Abstract cost groups"@en ;
  skos:prefLabel "Abstrakte Kostengruppen"@de ;
  dcterms:title "Abstract cost groups"@en ;
  dcterms:title "Abstrakte Kostengruppen"@de ;
  dcterms:identifier "AbstractCostGroup" ;
  dcterms:creator "pragmatic-bim-public-rules" ;
  dcterms:issued "2026-11-04" ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:source <https://github.com/simondilhas/pragmatic-bim-public-rules> ;
  dcterms:references map:abstractCostGroupsToIcmsMapping, map:abstractCostGroupsToEbkpHMapping, map:abstractCostGroupsToEbkpTMapping ;
  skos:definition "Open life-cycle cost structure for buildings and civil engineering works. Level 2 categories (CG-1 acquisition to CG-6 end of life), Level 3 groups (CG-{C}-{GG}) and Level 4 sub-groups (CG-{C}-{GG}-{SSS}). Construction, renewal and maintenance share the same thirteen groups. Sub-groups with a B prefix apply to buildings, those with a C prefix to civil engineering works (see pbs:projectType); sub-groups without a letter apply to all project types. Codes 800 and above are own extensions without an ICMS sub-group equivalent."@en ;
  skos:definition "Offene Lebenszyklus-Kostengliederung für Hochbau und Tiefbau. Kategorien der Ebene 2 (CG-1 Erwerb bis CG-6 Lebensende), Gruppen der Ebene 3 (CG-{C}-{GG}) und Untergruppen der Ebene 4 (CG-{C}-{GG}-{SSS}). Erstellung, Erneuerung und Instandhaltung teilen dieselben dreizehn Gruppen. Untergruppen mit Präfix B gelten für Gebäude, mit Präfix C für Tiefbauwerke (siehe pbs:projectType); Untergruppen ohne Buchstaben gelten für alle Projektarten. Codes ab 800 sind eigene Erweiterungen ohne ICMS-Untergruppe."@de ;
  skos:scopeNote "Own wording; group and sub-group numbering is aligned with ICMS 3 so that matches are exact by design. ICMS, eBKP-H and eBKP-T are referenced by code only in the mapping bridges; no third-party titles or definitions are reproduced. Level 4 sub-groups are provided for construction and acquisition; renewal and maintenance reuse the construction sub-group codes, operation and end of life stop at Level 3."@en ;
  skos:scopeNote "Eigene Formulierung; die Nummerierung von Gruppen und Untergruppen ist auf ICMS 3 abgestimmt, sodass die Entsprechungen per Konstruktion exakt sind. ICMS, eBKP-H und eBKP-T werden in den Mapping-Brücken nur über Codes referenziert; es werden keine fremden Bezeichnungen oder Definitionen wiedergegeben. Untergruppen der Ebene 4 bestehen für Erstellung und Erwerb; Erneuerung und Instandhaltung verwenden die Untergruppencodes der Erstellung, Betrieb und Lebensende enden auf Ebene 3."@de ;
  skos:hasTopConcept
    :CG-1,
    :CG-2,
    :CG-3,
    :CG-4,
    :CG-5,
    :CG-6 .

:CG-1 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "CG-1" ;
  skos:prefLabel "Acquisition"@en ;
  skos:prefLabel "Erwerb"@de ;
  skos:definition "Costs of securing the site and of the client's administration, finance, legal and marketing activities."@en ;
  skos:definition "Kosten für die Sicherung des Grundstücks sowie für Verwaltung, Finanzierung, Recht und Vermarktung durch die Bauherrschaft."@de ;
  skos:narrower :CG-1-01, :CG-1-02 .

:CG-2 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "CG-2" ;
  skos:prefLabel "Construction"@en ;
  skos:prefLabel "Erstellung"@de ;
  skos:definition "Costs of creating the constructed asset from site preparation to handover, including design and supervision."@en ;
  skos:definition "Kosten für die Erstellung des Bauwerks von der Baustellenvorbereitung bis zur Übergabe, einschliesslich Planung und Bauleitung."@de ;
  skos:narrower :CG-2-01, :CG-2-02, :CG-2-03, :CG-2-04, :CG-2-05, :CG-2-06, :CG-2-07, :CG-2-08, :CG-2-09, :CG-2-10, :CG-2-11, :CG-2-12, :CG-2-13 .

:CG-3 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "CG-3" ;
  skos:prefLabel "Renewal"@en ;
  skos:prefLabel "Erneuerung"@de ;
  skos:definition "Costs of replacing major components at the end of their service life after handover."@en ;
  skos:definition "Kosten für den Ersatz wesentlicher Bauteile am Ende ihrer Nutzungsdauer nach der Übergabe."@de ;
  skos:narrower :CG-3-01, :CG-3-02, :CG-3-03, :CG-3-04, :CG-3-05, :CG-3-06, :CG-3-07, :CG-3-08, :CG-3-09, :CG-3-10, :CG-3-11, :CG-3-12, :CG-3-13 .

:CG-4 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "CG-4" ;
  skos:prefLabel "Operation"@en ;
  skos:prefLabel "Betrieb"@de ;
  skos:definition "Recurring costs of running the asset during use."@en ;
  skos:definition "Wiederkehrende Kosten für den Betrieb des Bauwerks während der Nutzung."@de ;
  skos:narrower :CG-4-01, :CG-4-02, :CG-4-03, :CG-4-04, :CG-4-05, :CG-4-06, :CG-4-07, :CG-4-08 .

:CG-5 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "CG-5" ;
  skos:prefLabel "Maintenance"@en ;
  skos:prefLabel "Instandhaltung"@de ;
  skos:definition "Costs of keeping the asset in working condition through inspection, servicing and repair."@en ;
  skos:definition "Kosten für den Erhalt der Funktionsfähigkeit durch Inspektion, Wartung und Reparatur."@de ;
  skos:narrower :CG-5-01, :CG-5-02, :CG-5-03, :CG-5-04, :CG-5-05, :CG-5-06, :CG-5-07, :CG-5-08, :CG-5-09, :CG-5-10, :CG-5-11, :CG-5-12, :CG-5-13 .

:CG-6 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "CG-6" ;
  skos:prefLabel "End of life"@en ;
  skos:prefLabel "Lebensende"@de ;
  skos:definition "Costs of decommissioning, demolishing and reinstating at the end of the asset's life."@en ;
  skos:definition "Kosten für Ausserbetriebnahme, Rückbau und Wiederherstellung am Ende der Lebensdauer."@de ;
  skos:narrower :CG-6-01, :CG-6-02, :CG-6-03, :CG-6-04, :CG-6-05, :CG-6-06, :CG-6-07 .

:CG-1-01 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:broader :CG-1 ;
  skos:notation "CG-1-01" ;
  skos:prefLabel "Site acquisition"@en ;
  skos:prefLabel "Grundstückserwerb"@de ;
  skos:definition "Price and associated costs of securing land, building rights or existing property."@en ;
  skos:definition "Preis und Nebenkosten für den Erwerb von Land, Baurechten oder bestehenden Liegenschaften."@de ;
  skos:narrower :CG-1-01-010, :CG-1-01-020, :CG-1-01-030, :CG-1-01-040, :CG-1-01-050, :CG-1-01-060 .

:CG-1-02 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:broader :CG-1 ;
  skos:notation "CG-1-02" ;
  skos:prefLabel "Client administration, finance, legal and marketing"@en ;
  skos:prefLabel "Verwaltung, Finanzierung, Recht und Vermarktung der Bauherrschaft"@de ;
  skos:definition "Client-side overheads, interest, legal, accounting, sales and leasing costs."@en ;
  skos:definition "Gemeinkosten der Bauherrschaft, Zinsen, Rechts-, Buchhaltungs-, Verkaufs- und Vermietungskosten."@de ;
  skos:narrower :CG-1-02-010, :CG-1-02-020, :CG-1-02-030, :CG-1-02-040, :CG-1-02-050, :CG-1-02-060, :CG-1-02-070, :CG-1-02-080 .

