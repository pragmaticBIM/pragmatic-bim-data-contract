  skos:inScheme :scheme ;
  skos:broader :CG-2 ;
  skos:notation "CG-2-10" ;
  skos:prefLabel "Taxes and levies"@en ;
  skos:prefLabel "Steuern und Abgaben"@de ;
  skos:definition "Taxes and levies on construction payments."@en ;
  skos:definition "Steuern und Abgaben auf Zahlungen für die Erstellung."@de ;
  skos:narrower :CG-2-10-010, :CG-2-10-020 .

