@prefix : <https://example.org/abstract/door-connector-product/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

:scheme a skos:ConceptScheme ;
  skos:prefLabel "Abstract door connector products"@en ;
  skos:prefLabel "Abstrakte Tuer-Verbindungsprodukte"@de ;
  dcterms:title "Abstract door connector products"@en ;
  dcterms:identifier "AbstractDoorConnectorProduct" ;
  dcterms:creator "abstract" ;
  dcterms:issued "2026-06-30" ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:source <https://github.com/pragmaticBIM/pragmatic-bim-data-contract> ;
  skos:definition "Product-type classification for door connectors (ConnectionPhysical with functional type access; IFC physical type door). For catalog, specification, and cost workflows; pair with abstract material classification for frame and infill substance."@en ;
  skos:definition "Produkttyp-Klassifikation fuer Tuer-Verbindungen (ConnectionPhysical mit funktionalem Typ access; IFC-physischer Typ door). Fuer Katalog-, Spezifikations- und Kostenworkflows; mit abstrakter Materialklassifikation fuer Rahmen- und Fuellsubstanz kombinieren."@de ;
  skos:scopeNote "Default PBS entity is ConnectionPhysical. Interior vs exterior position is not encoded here; BKP bridges use closeMatch for Rohbau 221.x (exterior) and relatedMatch for Ausbau 272/273 (interior) where applicable."@en ;
  skos:scopeNote "Standard-PBS-Entitaet ist ConnectionPhysical. Innen- vs Aussenlage ist hier nicht kodiert; BKP-Mappings mit closeMatch fuer Rohbau 221.x (aussen) und relatedMatch fuer Ausbau 272/273 (innen) wo zutreffend."@de ;
  skos:hasTopConcept
    :DCP-WOOD,
    :DCP-METAL,
    :DCP-WOOD-METAL,
    :DCP-PVC,
    :DCP-GLASS,
    :DCP-GATE,
    :DCP-SPECIAL,
    :DCP-OTH .

:DCP-WOOD a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "DCP-WOOD" ;
  skos:prefLabel "Wood door system"@en ;
  skos:prefLabel "Holztuer"@de ;
  skos:definition "Door with primary wood frame and leaf, including solid wood and engineered-wood door systems."@en ;
  skos:definition "Tuer mit primaerem Holzrahmen und -blatt, einschliesslich Massivholz- und Holzwerkstoff-Tuersystemen."@de ;
  dcterms:description "Door assembly with a leaf of solid timber or wood-based board in a matching frame, closing an access opening in a wall or partition. Leaf and frame are produced and finished in the factory, the frame is fixed into the opening and grouted or foamed, then the leaf is hung and hardware, seals, and floor closure are adjusted. Suitable for interior access openings with acoustic, smoke, or fire compartmentation duty and for sheltered entrances; leaf surface and hardware have to withstand the expected traffic."@en ;
  dcterms:description "Türkonstruktion mit einem Blatt aus Vollholz oder Holzwerkstoffplatte in passender Zarge, die eine Zugangsöffnung in einer Wand oder Trennwand verschliesst. Blatt und Zarge werden werkseitig gefertigt und oberflächenbehandelt, die Zarge wird in der Öffnung befestigt und vermörtelt oder ausgeschäumt, danach wird das Blatt eingehängt und Beschläge, Dichtungen und Bodenanschluss werden eingestellt. Geeignet für innere Zugangsöffnungen mit Anforderungen an Schall-, Rauch- oder Brandabschnittstrennung sowie für geschützte Eingänge; Blattoberfläche und Beschläge müssen der erwarteten Beanspruchung genügen."@de ;
  dcterms:subject "IfcDoor" ;
  dcterms:identifier "wood-door" .

:DCP-METAL a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "DCP-METAL" ;
  skos:prefLabel "Metal door system"@en ;
  skos:prefLabel "Metalltuer"@de ;
  skos:definition "Door with primary steel or metal frame and leaf, including security and fire-rated metal doors."@en ;
  skos:definition "Tuer mit primaerem Stahl- oder Metallrahmen und -blatt, einschliesslich Sicherheits- und Brandschutz-Metalltueren."@de ;
  dcterms:description "Door assembly with leaf and frame of steel or other metal, usually a sheet-metal shell with an insulating or stiffening core, closing an access opening. Leaf and frame are welded, coated, and pre-fitted in the workshop, the frame is anchored into the reveal and the leaf hung with heavy-duty hinges, locking, and where required closers and panic hardware. Suitable for technical rooms, escape routes, and exterior or heavily used openings with fire compartmentation, smoke control, or burglar resistance duty."@en ;
  dcterms:description "Türkonstruktion mit Blatt und Rahmen aus Stahl oder anderem Metall, üblicherweise als Blechschale mit dämmendem oder aussteifendem Kern, die eine Zugangsöffnung verschliesst. Blatt und Rahmen werden in der Werkstatt geschweisst, beschichtet und vormontiert, der Rahmen wird in der Laibung verankert und das Blatt mit hochbelastbaren Bändern, Verschlüssen und bei Bedarf Türschliessern und Panikbeschlägen eingehängt. Geeignet für Technikräume, Fluchtwege sowie Aussen- und stark genutzte Öffnungen mit Anforderungen an Brandabschnitts-, Rauch- oder Einbruchschutz."@de ;
  dcterms:subject "IfcDoor" ;
  dcterms:identifier "metal-door" .

:DCP-WOOD-METAL a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "DCP-WOOD-METAL" ;
  skos:prefLabel "Wood–metal composite door"@en ;
  skos:prefLabel "Holz-Metall-Tuer"@de ;
  skos:definition "Door with wood interior face and exterior metal cladding or composite wood-aluminium frame system."@en ;
  skos:definition "Tuer mit Holzinnenseite und Metall-Aussenbekleidung oder Holz-Aluminium-Verbund-Rahmensystem."@de ;
  dcterms:description "Door assembly with timber leaf and frame on the room side and a metal cover shell or metal-faced composite profile on the weather side, closing an access opening in the building envelope. Leaf, frame, and cover profiles are combined in the factory, the frame is set into the reveal and sealed against the adjoining construction, and the leaf is hung on adjustable hinges with perimeter gaskets. Suitable for entrance and balcony openings where a timber interior surface is wanted and the exterior face has to stay weather-resistant and low-maintenance."@en ;
  dcterms:description "Türkonstruktion mit Blatt und Rahmen aus Holz auf der Raumseite und Metall-Deckschale oder metallbekleidetem Verbundprofil auf der Wetterseite, die eine Zugangsöffnung in der Gebäudehülle verschliesst. Blatt, Rahmen und Deckschalen werden im Werk zusammengefügt, der Rahmen wird in die Laibung eingesetzt und an die angrenzende Konstruktion abgedichtet, das Blatt auf verstellbaren Bändern mit umlaufenden Dichtungen eingehängt. Geeignet für Eingangs- und Balkonöffnungen, bei denen innen eine Holzoberfläche gewünscht und aussen ein wetterfester, wartungsarmer Abschluss gefordert ist."@de ;
  dcterms:subject "IfcDoor" ;
  dcterms:identifier "wood-metal-door" .

:DCP-PVC a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "DCP-PVC" ;
  skos:prefLabel "Plastic / PVC door system"@en ;
  skos:prefLabel "Kunststoff- / PVC-Tuer"@de ;
  skos:definition "Door with primary plastic, PVC, or synthetic frame and panel system."@en ;
  skos:definition "Tuer mit primaerem Kunststoff-, PVC- oder Synthetik-Rahmen und -paneelsystem."@de ;
  dcterms:description "Door assembly with plastic frame and leaf profiles, usually multi-chamber sections with internal reinforcement and a panel or glazed infill, closing an access opening. Profiles are welded and fitted with gaskets and hardware in the factory, the frame is set into the opening, anchored and sealed, and the leaf is adjusted to close tight all round. Suitable for secondary entrances, wet rooms, and openings where a washable, corrosion-free surface without coating renewal is required."@en ;
  dcterms:description "Türkonstruktion mit Rahmen- und Blattprofilen aus Kunststoff, üblicherweise Mehrkammerprofile mit innerer Armierung und Paneel- oder Glasfüllung, die eine Zugangsöffnung verschliesst. Die Profile werden im Werk verschweisst und mit Dichtungen und Beschlägen ausgerüstet, der Rahmen wird in die Öffnung eingesetzt, verankert und abgedichtet und das Blatt auf umlaufend dichten Anschlag eingestellt. Geeignet für Nebeneingänge, Feuchträume und Öffnungen, bei denen eine abwaschbare, korrosionsfreie Oberfläche ohne Anstricherneuerung gefordert ist."@de ;
  dcterms:subject "IfcDoor" ;
  dcterms:identifier "pvc-door" .

:DCP-GLASS a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "DCP-GLASS" ;
  skos:prefLabel "Glazed door system"@en ;
  skos:prefLabel "Glas- / Verglasungstuer"@de ;
  skos:definition "Door predominantly glazed with minimal frame, including automatic sliding glass doors and full-height glazed entrances."@en ;
  skos:definition "Ueberwiegend verglaste Tuer mit minimalem Rahmen, einschliesslich automatischer Schiebetueren und ganzverglaster Eingaenge."@de ;
  dcterms:description "Door assembly whose leaf consists mainly of glass, either frameless with clamped fittings or in a narrow metal frame, operating as a hinged, sliding, or automatic leaf within a glazed screen. Panes are toughened or laminated in the factory, the floor spring or guide rail and the surrounding screen are set and levelled on site, and the leaf is aligned and its operation commissioned. Suitable for entrance halls and interior openings with visual continuity; operation must stay safe for all users and the glass has to provide safe passage and be clearly marked."@en ;
  dcterms:description "Türkonstruktion, deren Blatt überwiegend aus Glas besteht, entweder rahmenlos mit Klemmbeschlägen oder in schmalem Metallrahmen, als Dreh-, Schiebe- oder Automatikflügel in einer verglasten Trennwand. Die Scheiben werden werkseitig vorgespannt oder als Verbundsicherheitsglas hergestellt, Bodentürschliesser oder Laufschiene und die umgebende Verglasung werden vor Ort gesetzt und ausgerichtet, danach wird das Blatt eingestellt und die Bedienung in Betrieb genommen. Geeignet für Eingangshallen und innere Öffnungen mit durchgehendem Sichtbezug; die Bedienung muss für alle Nutzenden sicher bleiben und das Glas gefahrloses Durchgehen sowie eine erkennbare Markierung gewährleisten."@de ;
  dcterms:subject "IfcDoor" ;
  dcterms:identifier "glass-door" .

:DCP-GATE a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "DCP-GATE" ;
  skos:prefLabel "Gate / industrial door"@en ;
  skos:prefLabel "Tor / Industrietuer"@de ;
  skos:definition "Large-format gate, sectional door, rolling shutter, or industrial door system."@en ;
  skos:definition "Grossformat-Tor, Sektionaltor, Rolltor oder Industrietuer-System."@de ;
  dcterms:description "Large-format closure of a vehicle or goods opening, as a sectional, rolling, sliding, folding, or up-and-over leaf with guide tracks and a weight compensation system. Panels, tracks, springs, and drive are prefabricated, assembled in the opening, anchored to the structural reveal or lintel, and commissioned together with drive, control, and safety devices. Suitable for garages, loading bays, and industrial halls with frequent operating cycles; requires edge and crush protection, a defined opening speed, manual emergency operation, and periodic inspection of the moving parts."@en ;
  dcterms:description "Grossformatiger Verschluss einer Fahrzeug- oder Warenöffnung, als Sektional-, Roll-, Schiebe-, Falt- oder Schwingtor mit Führungsschienen und Gewichtsausgleichssystem. Panele, Laufschienen, Federn und Antrieb werden vorgefertigt, in der Öffnung montiert, an der tragenden Laibung oder am Sturz verankert und mit Antrieb, Steuerung und Sicherheitseinrichtungen in Betrieb genommen. Geeignet für Garagen, Anlieferungen und Industriehallen mit häufigen Betriebszyklen; erfordert Kanten- und Quetschschutz, definierte Öffnungsgeschwindigkeit, manuelle Notbedienung und regelmässige Kontrolle der bewegten Teile."@de ;
  dcterms:subject "IfcDoor" ;
  dcterms:identifier "gate-door" .

:DCP-SPECIAL a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "DCP-SPECIAL" ;
  skos:prefLabel "Special door system"@en ;
  skos:prefLabel "Spezialtuer"@de ;
  skos:definition "Special-purpose door product such as revolving door, airtight door, acoustic door, or shopfront entrance system."@en ;
  skos:definition "Spezialtuer-Produkt wie Drehtuer, luftdichte Tuer, Schallschutztuer oder Schaufenster-Eingangssystem."@de ;
  dcterms:description "Purpose-made door product for an access opening with requirements beyond a standard leaf and frame, for example a revolving entrance, an airtight or pressure-resistant door, a high-performance acoustic door, a shielding door, or a shopfront entrance assembly. Manufactured to order as a complete unit including frame, seals, drive, and control, set and levelled in the prepared opening and commissioned with its operating and safety functions. Suitable where the opening has to combine access with a specific separating duty; the required performance, operating mode, and maintenance regime must be stated per case."@en ;
  dcterms:description "Auftragsbezogen gefertigtes Türprodukt für eine Zugangsöffnung mit Anforderungen über ein übliches Blatt-Zarge-System hinaus, zum Beispiel Karusselleingang, luftdichte oder druckfeste Tür, hochwirksame Schallschutztür, abschirmende Tür oder Schaufenster-Eingangsanlage. Wird als komplette Einheit mit Rahmen, Dichtungen, Antrieb und Steuerung auf Mass hergestellt, in der vorbereiteten Öffnung gesetzt und ausgerichtet und mit ihren Bedien- und Sicherheitsfunktionen in Betrieb genommen. Geeignet, wo die Öffnung Zugang mit einer bestimmten Trennfunktion verbinden muss; geforderte Leistung, Betriebsart und Unterhaltskonzept sind je Fall zu beschreiben."@de ;
  dcterms:subject "IfcDoor" ;
  dcterms:identifier "special-door" .

:DCP-OTH a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "DCP-OTH" ;
  skos:prefLabel "Other / unknown door"@en ;
  skos:prefLabel "Sonstige / unbekannte Tuer"@de ;
  skos:definition "Door connector product not classified or not yet known."@en ;
  skos:definition "Tuer-Verbindungsprodukt nicht klassifiziert oder noch unbekannt."@de ;
  dcterms:description "Placeholder for door products whose material, system, and operating type are not yet fixed or not classified at tender stage. Functional requirements for access, operation, separating duty, and connection to the adjoining construction must be stated separately. Use only in early design stages or where data is incomplete."@en ;
  dcterms:description "Platzhalter für Türprodukte, deren Material, System und Betätigungsart zum Zeitpunkt der Ausschreibung noch nicht festgelegt oder nicht klassifiziert sind. Funktionale Anforderungen an Zugang, Bedienung, Trennfunktion und Anschluss an die angrenzende Konstruktion sind gesondert zu beschreiben. Nur in frühen Planungsphasen oder bei unvollständiger Datenlage verwenden."@de ;
  skos:scopeNote "Fallback for early design stages or missing data."@en ;
  skos:scopeNote "Fallback fuer fruehe Entwurfsstufen oder fehlende Daten."@de ;
  dcterms:subject "IfcDoor" ;
  dcterms:identifier "other" .
