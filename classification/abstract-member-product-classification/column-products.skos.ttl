@prefix : <https://example.org/abstract/column-product/> .
@prefix pbs: <https://schema.pragmaticbim.ch/> .
@prefix map: <https://example.org/mapping/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scheme a skos:ConceptScheme ;
  skos:prefLabel "Abstract column products"@en ;
  skos:prefLabel "Abstrakte Stützenprodukte"@de ;
  dcterms:title "Abstract column products"@en ;
  dcterms:title "Abstrakte Stützenprodukte"@de ;
  dcterms:identifier "ColumnProduct" ;
  dcterms:creator "abstract.foundation" ;
  dcterms:issued "2026-09-16"^^xsd:date ;
  dcterms:modified "2026-09-16"^^xsd:date ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:source <https://github.com/pragmaticBIM/pragmatic-bim-data-contract> ;
  dcterms:references map:elementplanElementsToProductsMapping ;
  skos:definition "Product-type classification for vertical load-bearing members (columns and posts) by dominant construction material. Used to attach baseline unit prices and embodied carbon references to the column element of the pragmaticBIM Elementplan."@en ;
  skos:definition "Produkttyp-Klassifikation für vertikale Tragglieder (Stützen und Pfosten) nach dominierendem Baustoff. Dient der Zuordnung von Basis-Einheitspreisen und Referenzen für graue Emissionen zum Stützenbauteil des pragmaticBIM Elementplans."@de ;
  skos:scopeNote "Assign one concept per column element. Baseline cost is priced per m3 of gross member volume (Qto_ColumnBaseQuantities.GrossVolume). Covers architectural (ARC-COLUMN) and structural column elements; distinct from wall separator products (SWP) used for walls."@en ;
  skos:scopeNote "Ein Konzept pro Stützenbauteil zuordnen. Basiskosten pro m3 Bruttovolumen (Qto_ColumnBaseQuantities.GrossVolume). Umfasst architektonische (ARC-COLUMN) und tragende Stützenbauteile; abgegrenzt von Wandtrennelementprodukten (SWP)."@de ;
  skos:hasTopConcept
    :CLP-STEEL,
    :CLP-TIMBER,
    :CLP-RC,
    :CLP-OTH .

:CLP-STEEL a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "CLP-STEEL" ;
  skos:prefLabel "Steel column"@en ;
  skos:prefLabel "Stahlstütze"@de ;
  skos:definition "Hot-rolled, welded, or hollow-section steel column including corrosion protection and fire protection coating where required. Priced per m3 of gross member volume."@en ;
  skos:definition "Warmgewalzte, geschweisste oder Hohlprofil-Stahlstütze inklusive Korrosionsschutz und erforderlichem Brandschutzanstrich. Preis pro m3 Bruttovolumen."@de ;
  pbs:priceUnit "m3" ;
  dcterms:identifier "CLP-STEEL" .

:CLP-TIMBER a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "CLP-TIMBER" ;
  skos:prefLabel "Timber column"@en ;
  skos:prefLabel "Holzstütze"@de ;
  skos:definition "Solid, glued-laminated, or engineered timber column including connectors and surface treatment. Priced per m3 of gross member volume."@en ;
  skos:definition "Vollholz-, Brettschichtholz- oder Konstruktionsholzstütze inklusive Verbindungsmittel und Oberflächenbehandlung. Preis pro m3 Bruttovolumen."@de ;
  pbs:priceUnit "m3" ;
  dcterms:identifier "CLP-TIMBER" .

:CLP-RC a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "CLP-RC" ;
  skos:prefLabel "Reinforced concrete column"@en ;
  skos:prefLabel "Stahlbetonstütze"@de ;
  skos:definition "Cast-in-situ or precast reinforced concrete column including formwork and reinforcement. Priced per m3 of gross member volume."@en ;
  skos:definition "Ortbeton- oder Fertigteil-Stahlbetonstütze inklusive Schalung und Bewehrung. Preis pro m3 Bruttovolumen."@de ;
  pbs:priceUnit "m3" ;
  dcterms:identifier "CLP-RC" .

:CLP-OTH a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "CLP-OTH" ;
  skos:prefLabel "Other or unknown column"@en ;
  skos:prefLabel "Andere oder unbekannte Stütze"@de ;
  skos:definition "Fallback for columns whose material or product type is not yet determined, or for composite and masonry columns outside the listed types."@en ;
  skos:definition "Rückfallwert für Stützen mit noch unbestimmtem Material oder Produkttyp sowie für Verbund- und Mauerwerksstützen ausserhalb der gelisteten Typen."@de ;
  pbs:priceUnit "m3" ;
  dcterms:identifier "CLP-OTH" .
