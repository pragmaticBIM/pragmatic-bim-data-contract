@prefix : <https://example.org/abstract/outdoor-floor-surface/> .
@prefix map: <https://example.org/mapping/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

:scheme a skos:ConceptScheme ;
  skos:prefLabel "Abstract outdoor floor surfaces"@en ;
  skos:prefLabel "Abstrakte Aussenbodenbeläge"@de ;
  dcterms:title "Abstract outdoor floor surfaces"@en ;
  dcterms:identifier "AbstractOutdoorFloorSurface" ;
  dcterms:creator "abstract" ;
  dcterms:issued "2026-09-22" ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:source <https://github.com/pragmaticBIM/pragmatic-bim-data-contract> ;
  dcterms:references map:outdoorFloorSurfacesToOutdoorRoomNameMapping ;
  skos:definition "Hierarchical classification of outdoor horizontal wearing courses by permeability. Tags the surface finish material, not the space use. Space or landscape function (garden, retention, pond) is classified separately via building space name (RN-*). Distinct from indoor floor covering products (FCP)."@en ;
  skos:definition "Hierarchische Klassifikation horizontaler Aussen-Nutzschichten nach Durchlässigkeit. Kennzeichnet den Oberflächenbelag, nicht die Raumnutzung. Raum- oder Landschaftsfunktion (Garten, Retention, Teich) wird separat über den Gebäuderaumnamen (RN-*) klassifiziert. Unterscheidet sich von Innen-Bodenbelagsprodukten (FCP)."@de ;
  skos:scopeNote "Top concepts are permeability classes (AOF-01 to AOF-03). Assign a leaf notation when a specific surface material is known; otherwise assign the parent class. Do not use this scheme for vegetated areas or open waterbodies as space types."@en ;
  skos:scopeNote "Top-Konzepte sind Durchlässigkeitsklassen (AOF-01 bis AOF-03). Bei bekanntem Oberflächenmaterial Blattnotation zuweisen, sonst die Elternklasse. Nicht für begrünte Flächen oder offene Wasserflächen als Raumtypen verwenden."@de ;
  skos:hasTopConcept :AOF-01, :AOF-02, :AOF-03 .

:AOF-01 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "AOF-01" ;
  skos:prefLabel "Sealed"@en ;
  skos:prefLabel "Versiegelt"@de ;
  skos:definition "Impervious outdoor wearing course that sheds almost all precipitation as surface runoff."@en ;
  skos:definition "Undurchlässige Aussen-Nutzschicht, die Niederschlag weitgehend als Oberflächenabfluss ableitet."@de ;
  skos:narrower :AOF-01-01, :AOF-01-02 ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "sealed" .

:AOF-01-01 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:notation "AOF-01-01" ;
  skos:prefLabel "Asphalt"@en ;
  skos:prefLabel "Asphalt"@de ;
  skos:definition "Sealed outdoor wearing course of asphalt pavement."@en ;
  skos:definition "Versiegelte Aussen-Nutzschicht aus Asphaltbelag."@de ;
  skos:broader :AOF-01 ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "asphalt" .

:AOF-01-02 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:notation "AOF-01-02" ;
  skos:prefLabel "Concrete"@en ;
  skos:prefLabel "Beton"@de ;
  skos:definition "Sealed outdoor wearing course of concrete pavement or slab."@en ;
  skos:definition "Versiegelte Aussen-Nutzschicht aus Betonbelag oder -platte."@de ;
  skos:broader :AOF-01 ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "concrete" .

:AOF-02 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "AOF-02" ;
  skos:prefLabel "Partially permeable"@en ;
  skos:prefLabel "Teildurchlässig"@de ;
  skos:definition "Outdoor wearing course that allows partial infiltration through joints, voids, or a bound but permeable surface layer."@en ;
  skos:definition "Aussen-Nutzschicht mit teilweiser Versickerung über Fugen, Hohlräume oder eine gebundene, aber durchlässige Deckschicht."@de ;
  skos:narrower :AOF-02-01, :AOF-02-02, :AOF-02-03 ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "partially-permeable" .

:AOF-02-01 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:notation "AOF-02-01" ;
  skos:prefLabel "Paving with joints"@en ;
  skos:prefLabel "Pflaster mit Fugen"@de ;
  skos:definition "Partially permeable paving units with open or permeable joints."@en ;
  skos:definition "Teildurchlässiges Pflaster mit offenen oder durchlässigen Fugen."@de ;
  skos:broader :AOF-02 ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "paving-with-joints" .

:AOF-02-02 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:notation "AOF-02-02" ;
  skos:prefLabel "Grass pavers"@en ;
  skos:prefLabel "Rasengittersteine"@de ;
  skos:definition "Partially permeable grid pavers intended for grass or gravel fill."@en ;
  skos:definition "Teildurchlässige Gittersteine für Rasen- oder Kiesfüllung."@de ;
  skos:broader :AOF-02 ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "grass-pavers" .

:AOF-02-03 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:notation "AOF-02-03" ;
  skos:prefLabel "Water-bound surface"@en ;
  skos:prefLabel "wassergebundene Decke"@de ;
  skos:definition "Partially permeable water-bound mineral wearing course."@en ;
  skos:definition "Teildurchlässige wassergebundene mineralische Nutzschicht."@de ;
  skos:broader :AOF-02 ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "water-bound-surface" .

:AOF-03 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "AOF-03" ;
  skos:prefLabel "Permeable"@en ;
  skos:prefLabel "Durchlässig"@de ;
  skos:definition "Permeable outdoor wearing course of unbound mineral cover that infiltrates precipitation."@en ;
  skos:definition "Durchlässige Aussen-Nutzschicht aus ungebundenem mineralischem Belag mit Versickerung des Niederschlags."@de ;
  skos:narrower :AOF-03-01 ;
  skos:scopeNote "Vegetated areas and open water are space types (RN-*), not outdoor floor surface materials."@en ;
  skos:scopeNote "Begrünte Flächen und offene Wasserflächen sind Raumtypen (RN-*), keine Aussenbodenbeläge."@de ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "permeable" .

:AOF-03-01 a skos:Concept ;
  skos:inScheme :scheme ;
  skos:notation "AOF-03-01" ;
  skos:prefLabel "Gravel"@en ;
  skos:prefLabel "Kies"@de ;
  skos:definition "Permeable unbound gravel wearing course."@en ;
  skos:definition "Durchlässige ungebundene Kies-Nutzschicht."@de ;
  skos:broader :AOF-03 ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "gravel" .
