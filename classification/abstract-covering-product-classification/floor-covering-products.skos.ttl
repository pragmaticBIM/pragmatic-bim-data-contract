@prefix : <https://example.org/abstract/floor-covering-product/> .
@prefix kbobbm: <https://example.org/ch/kbob/ecobilans/baumat/2009-1-2022/> .
@prefix map: <https://example.org/mapping/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

:scheme a skos:ConceptScheme ;
  skos:prefLabel "Abstract floor covering products"@en ;
  skos:prefLabel "Abstrakte Bodenbelagsprodukte"@de ;
  dcterms:title "Abstract floor covering products"@en ;
  dcterms:identifier "AbstractFloorCoveringProduct" ;
  dcterms:creator "abstract" ;
  dcterms:issued "2026-06-30" ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:source <https://github.com/pragmaticBIM/pragmatic-bim-data-contract> ;
  dcterms:references map:abstractFloorCoveringProductsToKbobEcobilansMapping, kbobbm:scheme ;
  skos:scopeNote "Embodied carbon: resolve product notation via the referenced KBOB ecobilans mapping bridge (skos:closeMatch on layer narrowers where present; skos:relatedMatch on parent composites). Links KBOB Baumaterialien row notations only; obtain indicator values from the official KBOB ecobilans dataset."@en ;
  skos:scopeNote "Graue Emissionen: Produktnotation ueber referenzierte KBOB-Oekobilanz-Mapping-Bruecke aufloesen (skos:closeMatch auf Schicht-narrower; skos:relatedMatch auf Eltern-Verbundprodukte). Verknuepft nur KBOB-Baumaterialien-Zeilennotationen; Kennwerte aus offiziellem KBOB-Oekobilanzdatensatz beziehen."@de ;
  skos:definition "Product-type classification for installed floor coverings and related floor finish systems. For catalog, specification, and cost workflows; pair with abstract material classification for dominant substance."@en ;
  skos:definition "Produkttyp-Klassifikation fuer eingebaute Bodenbelaege und zugehoerige Bodenaufbauten. Fuer Katalog-, Spezifikations- und Kostenworkflows; mit abstrakter Materialklassifikation fuer dominante Substanz kombinieren."@de ;
  skos:scopeNote "Default PBS entity is Boundary with boundary_type flooring (IfcCovering FLOORING). Tags product or system type, not dominant substance alone."@en ;
  skos:scopeNote "Standard-PBS-Entitaet ist Boundary mit boundary_type flooring (IfcCovering FLOORING). Kennzeichnet Produkt- oder Systemtyp, nicht allein dominante Substanz."@de ;
  skos:hasTopConcept
    :FCP-SUBFLOOR,
    :FCP-SEAMLESS-RESIN,
    :FCP-CARPET,
    :FCP-LVT,
    :FCP-LINOLIUM,
    :FCP-NATURAL-STONE,
    :FCP-ARTIFICIAL-STONE,
    :FCP-CERAMIC-TILE,
    :FCP-PARQUET,
    :FCP-LAMINATE,
    :FCP-RAISED-FLOOR,
    :FCP-OTH .

:FCP-SUBFLOOR a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "FCP-SUBFLOOR" ;
  skos:prefLabel "Subfloor / leveling layer"@en ;
  skos:prefLabel "Unterlagsboden / Ausgleichsschicht"@de ;
  skos:definition "Subfloor preparation or leveling screed layer beneath the visible floor finish."@en ;
  skos:definition "Unterlagsvorbereitung oder Ausgleichsestrich unter dem sichtbaren Bodenbelag."@de ;
  dcterms:description "Load-distributing and levelling layer between the structural slab and the visible floor finish. Placed as a bonded, floating, or heated screed on separation and impact-sound layers, levelled and cured until ready to receive the covering. Delivers an even, dry, and load-bearing substrate and takes up floor heating, service runs, and the level compensation of the storey."@en ;
  dcterms:description "Last verteilende und ausgleichende Schicht zwischen Rohdecke und sichtbarem Bodenbelag. Als verbundener, schwimmender oder beheizter Unterlagsboden auf Trenn- und Trittschallschichten eingebracht, abgezogen und bis zur Belegreife ausgehärtet. Sie stellt einen ebenen, trockenen und tragfähigen Untergrund bereit und nimmt Bodenheizung, Installationsführungen und den Niveauausgleich des Geschosses auf."@de ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "subfloor" .

:FCP-SEAMLESS-RESIN a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "FCP-SEAMLESS-RESIN" ;
  skos:prefLabel "Seamless resin floor"@en ;
  skos:prefLabel "Fugenloser Kunstharzboden"@de ;
  skos:definition "Poured or troweled seamless resin, epoxy, or polyurethane floor finish."@en ;
  skos:definition "Gegossener oder gezogener fugenloser Kunstharz-, Epoxid- oder Polyurethan-Bodenbelag."@de ;
  dcterms:description "Jointless wearing surface applied in liquid form onto a prepared screed and cured in place. Primer, resin coats, and optional aggregate broadcast or sealer are rolled, poured, or troweled and continue without joints into coving at the walls. Suitable for rooms with hygiene, chemical resistance, or cleanability requirements and for heavy foot and wheeled traffic."@en ;
  dcterms:description "Fugenlose Nutzschicht, die flüssig auf einen vorbereiteten Unterlagsboden aufgebracht wird und vor Ort aushärtet. Grundierung, Harzschichten sowie optionale Einstreuung oder Versiegelung werden gerollt, gegossen oder gespachtelt und laufen ohne Fugen in Hohlkehlen an den Wänden aus. Geeignet für Räume mit Anforderungen an Hygiene, Chemikalienbeständigkeit oder Reinigbarkeit und für hohe Geh- und Rollbelastung."@de ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "seamless-resin-floor" .

:FCP-CARPET a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "FCP-CARPET" ;
  skos:prefLabel "Textile carpet"@en ;
  skos:prefLabel "Textiler Teppichbelag"@de ;
  skos:definition "Installed textile carpet, carpet tile, or broadloom floor covering."@en ;
  skos:definition "Eingebauter textiler Teppich, Teppichplatte oder Bahnenware als Bodenbelag."@de ;
  dcterms:description "Textile wearing surface on a prepared screed or subfloor, delivering a soft, sound-absorbing walking surface. Supplied as broadloom or tiles and fully adhered, tackified, or loose-laid on the levelled substrate, with seams and edge profiles closed. Suitable for offices, meeting rooms, and residential areas with moderate traffic and demands on room acoustics and walking comfort."@en ;
  dcterms:description "Textile Nutzschicht auf vorbereitetem Unterlagsboden, die eine weiche, schallabsorbierende Gehfläche bildet. Als Bahnenware oder Platten geliefert und vollflächig verklebt, fixiert oder lose auf dem ausgeglichenen Untergrund verlegt, mit geschlossenen Nähten und Randprofilen. Geeignet für Büros, Besprechungsräume und Wohnbereiche mit mittlerer Beanspruchung und Anforderungen an Raumakustik und Gehkomfort."@de ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "carpet" .

:FCP-LVT a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "FCP-LVT" ;
  skos:prefLabel "Vinyl / LVT floor"@en ;
  skos:prefLabel "Vinyl- / LVT-Bodenbelag"@de ;
  skos:definition "Vinyl sheet, luxury vinyl tile (LVT), or PVC-based resilient floor covering."@en ;
  skos:definition "Vinylbahnen, Luxury-Vinyl-Fliesen (LVT) oder PVC-basierter elastischer Bodenbelag."@de ;
  dcterms:description "Resilient wearing surface from vinyl sheet or tile on a prepared screed, delivering a hard-wearing and easily cleaned walking surface. Laid fully adhered or as a click system floating on the levelled substrate, with seams welded or sealed where watertightness is required. Suitable for heavily used rooms and wet-cleaned areas, including in combination with floor heating."@en ;
  dcterms:description "Elastische Nutzschicht aus Vinylbahnen oder -platten auf vorbereitetem Unterlagsboden, die eine strapazierfähige und leicht zu reinigende Gehfläche bildet. Vollflächig verklebt oder als Klicksystem schwimmend auf dem ausgeglichenen Untergrund verlegt, mit verschweissten oder versiegelten Nähten, wo Wasserdichtheit gefordert ist. Geeignet für stark genutzte Räume und feucht zu reinigende Bereiche, auch in Kombination mit Bodenheizung."@de ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "lvt" .

:FCP-LINOLIUM a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "FCP-LINOLIUM" ;
  skos:prefLabel "Linoleum"@en ;
  skos:prefLabel "Linoleum"@de ;
  skos:definition "Linoleum or linoleum-composite resilient floor covering."@en ;
  skos:definition "Linoleum oder Linoleum-Verbund als elastischer Bodenbelag."@de ;
  dcterms:description "Resilient wearing surface from linoleum on a prepared screed, delivering a hard-wearing walking surface from largely renewable raw materials. Laid as sheet or tile fully adhered onto the levelled substrate, with welded or sealed seams and matching skirting details. Suitable for schools, healthcare buildings, and offices with high traffic and demands on cleanability and durability."@en ;
  dcterms:description "Elastische Nutzschicht aus Linoleum auf vorbereitetem Unterlagsboden, die eine strapazierfähige Gehfläche aus weitgehend erneuerbaren Rohstoffen bildet. Als Bahnen- oder Plattenbelag vollflächig auf dem ausgeglichenen Untergrund verklebt, mit verschweissten oder versiegelten Nähten und passender Sockelausbildung. Geeignet für Schulen, Gesundheitsbauten und Büros mit hoher Beanspruchung und Anforderungen an Reinigbarkeit und Dauerhaftigkeit."@de ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "linoleum" .

:FCP-NATURAL-STONE a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "FCP-NATURAL-STONE" ;
  skos:prefLabel "Natural stone flooring"@en ;
  skos:prefLabel "Naturstein-Bodenbelag"@de ;
  skos:definition "Installed natural stone slab, tile, or flag floor finish."@en ;
  skos:definition "Eingebauter Naturstein als Platte, Fliese oder Plattenbelag."@de ;
  dcterms:description "Wearing surface from quarried stone slabs or tiles on a prepared substrate, delivering a heavy and highly durable walking surface. Laid in a mortar bed or thin-bed adhesive on the screed, jointed, and finished by grinding, honing, or sealing. Suitable for entrances, circulation areas, and representative rooms with heavy traffic, and increases the dead load of the floor build-up."@en ;
  dcterms:description "Nutzschicht aus Natursteinplatten oder -fliesen auf vorbereitetem Untergrund, die eine schwere und sehr dauerhafte Gehfläche bildet. Im Mörtelbett oder Dünnbettkleber auf dem Unterlagsboden verlegt, verfugt und durch Schleifen, Polieren oder Imprägnieren fertiggestellt. Geeignet für Eingänge, Verkehrsflächen und repräsentative Räume mit hoher Beanspruchung und erhöht das Eigengewicht des Bodenaufbaus."@de ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "natural-stone-floor" .

:FCP-ARTIFICIAL-STONE a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "FCP-ARTIFICIAL-STONE" ;
  skos:prefLabel "Artificial stone flooring"@en ;
  skos:prefLabel "Kunststein-Bodenbelag"@de ;
  skos:definition "Installed artificial or agglomerate stone floor finish."@en ;
  skos:definition "Eingebauter Kunst- oder Agglomeratstein als Bodenbelag."@de ;
  dcterms:description "Wearing surface from cast or agglomerate stone slabs and tiles on a prepared substrate, delivering a stone-like walking surface with consistent format and appearance. Laid in a mortar bed or thin-bed adhesive, jointed, and ground or sealed on site where required. Suitable for circulation and utility areas with heavy traffic where uniform surfaces and large repeat quantities are required."@en ;
  dcterms:description "Nutzschicht aus gegossenen oder Agglomerat-Steinplatten und -fliesen auf vorbereitetem Untergrund, die eine steinartige Gehfläche mit gleichmässigem Format und Erscheinungsbild bildet. Im Mörtelbett oder Dünnbettkleber verlegt, verfugt und bei Bedarf vor Ort geschliffen oder imprägniert. Geeignet für Verkehrs- und Nebenflächen mit hoher Beanspruchung, wenn einheitliche Oberflächen und grosse Wiederholmengen gefordert sind."@de ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "artificial-stone-floor" .

:FCP-CERAMIC-TILE a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "FCP-CERAMIC-TILE" ;
  skos:prefLabel "Ceramic / porcelain tile floor"@en ;
  skos:prefLabel "Keramik- / Feinsteinzeug-Bodenbelag"@de ;
  skos:definition "Installed ceramic, porcelain, or stoneware tile floor finish."@en ;
  skos:definition "Eingebauter Keramik-, Feinsteinzeug- oder Steingutfliesen-Bodenbelag."@de ;
  dcterms:description "Wearing surface from fired ceramic tiles on a prepared substrate, delivering a hard, water-resistant, and abrasion-resistant walking surface. Set in thin-bed adhesive on the screed, with grouted joints, movement joints, and a bonded waterproofing layer in wet areas. Suitable for bathrooms, kitchens, and heavily used circulation areas with demands on slip resistance and moisture exposure."@en ;
  dcterms:description "Nutzschicht aus gebrannten Keramikfliesen auf vorbereitetem Untergrund, die eine harte, wasser- und abriebfeste Gehfläche bildet. Im Dünnbettkleber auf dem Unterlagsboden verlegt, mit verfugten Stössen, Bewegungsfugen und in Nassbereichen mit einer Verbundabdichtung. Geeignet für Bäder, Küchen und stark genutzte Verkehrsflächen mit Anforderungen an Trittsicherheit und Feuchtebeanspruchung."@de ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "ceramic-tile-floor" .

:FCP-PARQUET a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "FCP-PARQUET" ;
  skos:prefLabel "Parquet / engineered wood floor"@en ;
  skos:prefLabel "Parkett / Mehrschicht-Holzboden"@de ;
  skos:definition "Solid parquet, engineered wood, or wood-strip floor finish."@en ;
  skos:definition "Massivparkett, Mehrschicht-Holzboden oder Stabholz als Bodenbelag."@de ;
  dcterms:description "Wearing surface from solid or multi-layer timber elements on a prepared substrate, delivering a warm walking surface with a renewable wear layer. Laid fully adhered, nailed, or floating on the screed, then sanded and sealed or oiled on site. Suitable for residential, office, and assembly rooms with moderate traffic and a stable indoor climate, and can be re-sanded several times."@en ;
  dcterms:description "Nutzschicht aus Vollholz- oder Mehrschichtholzelementen auf vorbereitetem Untergrund, die eine warme Gehfläche mit erneuerbarer Nutzschicht bildet. Vollflächig verklebt, genagelt oder schwimmend auf dem Unterlagsboden verlegt und vor Ort geschliffen und versiegelt oder geölt. Geeignet für Wohn-, Büro- und Versammlungsräume mit mittlerer Beanspruchung und stabilem Raumklima und mehrfach nachschleifbar."@de ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "parquet" .

:FCP-LAMINATE a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "FCP-LAMINATE" ;
  skos:prefLabel "Laminate flooring"@en ;
  skos:prefLabel "Laminatboden"@de ;
  skos:definition "Laminate floor board with decorative surface layer."@en ;
  skos:definition "Laminatboden mit dekorativer Deckschicht."@de ;
  dcterms:description "Wearing surface from board elements with a printed, resin-impregnated decorative top layer on a wood-based core. Laid floating with click joints on an impact-sound and separation underlay over the screed, with perimeter expansion gaps and skirtings. Suitable for rooms with low to moderate traffic in dry use where fast and low-cost installation is required; the wear layer cannot be re-sanded."@en ;
  dcterms:description "Nutzschicht aus Plattenelementen mit bedruckter, harzimprägnierter Dekorschicht auf einem Holzwerkstoffkern. Schwimmend mit Klickverbindung auf einer Trittschall- und Trennunterlage über dem Unterlagsboden verlegt, mit Randdehnfugen und Sockelleisten. Geeignet für Räume mit geringer bis mittlerer Beanspruchung in trockener Nutzung, wenn eine rasche und kostengünstige Verlegung gefordert ist; die Nutzschicht ist nicht nachschleifbar."@de ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "laminate-floor" .

:FCP-RAISED-FLOOR a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "FCP-RAISED-FLOOR" ;
  skos:prefLabel "Raised / access floor"@en ;
  skos:prefLabel "Doppelboden / Hohlraumboden"@de ;
  skos:definition "Raised access floor system with pedestals and removable panels."@en ;
  skos:definition "Hohlraumboden- oder Doppelbodensystem mit Stuetzen und abnehmbaren Paneelen."@de ;
  dcterms:description "Elevated floor construction that forms a continuous accessible cavity between the structural slab and the walking level. Removable panels rest on height-adjustable pedestals or on a self-supporting cavity build-up and carry the final finish, applied in the factory or laid separately. Suitable for office, technical, and server rooms with dense service distribution, frequent reconfiguration, and defined point and distributed load capacity."@en ;
  dcterms:description "Erhöhte Bodenkonstruktion, die einen durchgehenden, zugänglichen Hohlraum zwischen Rohdecke und Gehniveau bildet. Abnehmbare Paneele liegen auf höhenverstellbaren Stützen oder auf einem selbsttragenden Hohlraumaufbau und nehmen den Fertigbelag auf, werkseitig aufgebracht oder separat verlegt. Geeignet für Büro-, Technik- und Serverräume mit dichter Installationsführung, häufigen Umnutzungen und definierter Punkt- und Flächenlast."@de ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "raised-floor" .

:FCP-OTH a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "FCP-OTH" ;
  skos:prefLabel "Other / unknown floor covering"@en ;
  skos:prefLabel "Sonstiger / unbekannter Bodenbelag"@de ;
  skos:definition "Floor covering product not classified or not yet known."@en ;
  skos:definition "Bodenbelagsprodukt nicht klassifiziert oder noch unbekannt."@de ;
  dcterms:description "Placeholder for floor covering products whose system type is not yet fixed or not classified at tender stage. Functional requirements such as wear class, slip resistance, impact-sound reduction, moisture exposure, and cleanability must be stated separately. Use only in early design stages or where data is incomplete."@en ;
  dcterms:description "Platzhalter für Bodenbelagsprodukte, deren Systemtyp zum Zeitpunkt der Ausschreibung noch nicht festgelegt oder nicht klassifiziert ist. Funktionale Anforderungen wie Nutzungsklasse, Trittsicherheit, Trittschallminderung, Feuchtebeanspruchung und Reinigbarkeit sind gesondert zu beschreiben. Nur in frühen Planungsphasen oder bei unvollständiger Datenlage verwenden."@de ;
  skos:scopeNote "Fallback for early design stages or missing data."@en ;
  skos:scopeNote "Fallback fuer fruehe Entwurfsstufen oder fehlende Daten."@de ;
  dcterms:subject "IfcCovering" ;
  dcterms:identifier "other" .
